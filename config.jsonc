{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
      "type": "file",
      "source": "~/.config/fastfetch/logo.txt",
      "color": {
        "1": "#b4befe",
        "2": "#94e2d5"
      },
      "padding": {
        "top": 1,
        "right": 3
      }
    },
  "display": {
    "separator": " ",
    "color": {
      "keys": "38;2;148;226;213",
      "title": "38;2;180;190;254",
      "output": "38;2;205;214;244"
    },
    "size": {
      "binaryPrefix": "si"
    }
  },
  "modules": [
    "title",
    // HARDWARE
    {
      "type": "custom",
      "format": "{#title}┌── {#keys} Hardware {#title}────────────────────────────────────┐"
    },
    {
      "type": "host",
      "key": "│ "
    },
    {
      "type": "cpu",
      "key": "│ ├─ ",
      "format": "{1}"
    },
    {
      "type": "gpu",
      "key": "│ ├─ "
    },
    {
      "type": "display",
      "key": "│ ├─ 󰍹"
    },
    {
      "type": "memory",
      "key": "│ ├─ "
    },
    {
      "type": "disk",
      "key": "│ ├─ ",
      "folders": "/"
    },
    {
      "type": "battery",
      "key": "│ └─ "
    },
    {
      "type": "custom",
      "format": "{#title}└──────────────────────────────────────────────────┘"
    },
    // SOFTWARE
    {
      "type": "custom",
      "format": "{#title}┌── {#keys} Software {#title}──────────────┐"
    },
    {
      "type": "os",
      "key": "│ "
    },
    {
      "type": "kernel",
      "key": "│ ├─ "
    },
    {
      "type": "uptime",
      "key": "│ ├─ "
    },
    {
      "type": "packages",
      "key": "│ ├─ "
    },
    {
      "type": "shell",
      "key": "│ ├─ "
    },
    {
      "type": "terminal",
      "key": "│ └─ "
    },
    {
      "type": "custom",
      "format": "{#title}└────────────────────────────┘"
    },
    // DESKTOP
    {
      "type": "custom",
      "format": "{#title}┌── {#keys} Desktop {#title}──────────────┐"
    },
    {
      "type": "de",
      "key": "│ "
    },
    {
      "type": "wm",
      "key": "│ ├─ "
    },
    {
      "type": "wmtheme",
      "key": "│ ├─ "
    },
    {
      "type": "theme",
      "key": "│ └─ ",
      "format": "{1}"
    },
    {
      "type": "custom",
      "format": "{#title}└───────────────────────────┘"
    },
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 2
    }
  ]
}
